digraph Somata818 {
  graph [fontname="DejaVu Sans",rankdir=TB, bgcolor="white",pad="0.26",nodesep="0.29",ranksep="0.49",splines=ortho,label="Somata 8.18.0 — рендер и исправленные маршруты",labelloc=t,fontsize=19];
  node [fontname="DejaVu Sans",shape=box,style="rounded,filled",fillcolor="#F3F6FA",color="#8597AB",fontsize=10,margin="0.19,0.12"];
  edge [color="#70849B",arrowsize=0.65,penwidth=1.15];
  solo [label="UI / Solo третьего слоя\n+ Graffiti / настройки проблеска",fillcolor="#DFEDF9",color="#5497CB"];
  authored [label="Authored state.layers\nвидимость, профиль каждой линии,\nдлина Graffiti=3 для новых слоёв",fillcolor="#D9F1E1",color="#5A9E76"];
  orange [label="Orange generator\nнаследует Graffiti по слоту,\nне применяет старый глобальный override",fillcolor="#D9F1E1",color="#5A9E76"];
  morph [label="Blue / Orange / Green Morph\nController + providers",fillcolor="#F0EAF9",color="#9879C2"];
  frame [label="Frame snapshot\nGreen Solo -> актуальная видимость\nГотовность Graffiti GPU",fillcolor="#D9F1E1",color="#5A9E76"];
  ordinary [label="FrameContour\nPolygon / обычный Morph",fillcolor="#E9F1FA"];
  strictRail [label="Retained Bézier/GPU rail\nstrict Spiral (без CPU fallback)",fillcolor="#E9F1FA"];
  effects [label="RenderGraph / Pass Registry\nFill · Web · Glow · Base · Graffiti\nLamps · Sweep/Glint · Lightning · Particles",fillcolor="#FFF3DB",color="#D19C40"];
  glint [label="Glint: perPath по умолчанию\nкаждый независимый контур\nperSegment остаётся доступен",fillcolor="#D9F1E1",color="#5A9E76"];
  gpu [label="Layer Scene / GPU + Canvas\nобщий порядок композиции",fillcolor="#E4EDF9"];
  output [label="Frame Scene -> Canvas",fillcolor="#E5EAF0"];
  solo -> authored; authored -> orange; authored -> morph; orange -> morph; morph -> frame;
  frame -> ordinary; frame -> strictRail; ordinary -> effects; strictRail -> effects; glint -> effects; effects -> gpu; gpu -> output;
  {rank=same; ordinary; strictRail;} 
}
